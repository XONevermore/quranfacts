<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup (Android 11 and older): only the user's own settings and bookmarks (quran_facts.xml). The subscription
     state in it is re-checked with Google Play on every start, so a restored copy cannot unlock anything by itself. -->
<full-backup-content>
    <include domain="sharedpref" path="quran_facts.xml" />
</full-backup-content>
